# scripts/dev_hosts.env.example — template for the OPTIONAL local
# multi-OS verification fan-out (ADR-0206).
#
# GitHub CI (`ci-required`) already runs the full 3-OS gate on every PR;
# nothing here is required to contribute. If you want the same
# verification locally against your own machines:
#
#   1. cp scripts/dev_hosts.env.example scripts/dev_hosts.env
#   2. Edit the three values below for your hosts.
#   3. bash scripts/gate_merge.sh            # full local pre-flight
#      bash scripts/run_remote_ubuntu.sh …   # or the per-host runners
#
# `dev_hosts.env` is gitignored (per-machine). The `: "${VAR:=…}"` form
# means an already-exported environment variable always wins over this
# file, and the scripts' built-in defaults apply when neither is set.
#
# Host requirements (see .dev/ubuntunote_setup.md / windows_ssh_setup.md
# for full provisioning notes):
#   - an SSH alias reachable with BatchMode (key auth, no prompt)
#   - Zig 0.16.0 on the remote PATH (or via the repo's nix shell)
#   - this repository cloned at $ZWASM_REMOTE_DIR with `origin` set

# x86_64 Linux gate host (SSH alias).
: "${ZWASM_UBUNTU_HOST:=my-linux-host}"

# x86_64 Windows gate host (SSH alias; OpenSSH server + bash).
: "${ZWASM_WINDOWS_HOST:=my-windows-host}"

# Repo clone path on the remote hosts (relative to the remote $HOME).
: "${ZWASM_REMOTE_DIR:=zwasm}"

export ZWASM_UBUNTU_HOST ZWASM_WINDOWS_HOST ZWASM_REMOTE_DIR
